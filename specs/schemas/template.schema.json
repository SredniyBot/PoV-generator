{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pov-generator.local/schemas/registry-object.schema.json",
  "title": "PoV Generator Registry Object",
  "description": "v2.1 registry DSL: objective, task_template, artifact_contract, domain_pack, methodology_pack, quality_gate, vocabulary.",
  "oneOf": [
    { "$ref": "#/$defs/Objective" },
    { "$ref": "#/$defs/TaskTemplate" },
    { "$ref": "#/$defs/ArtifactContract" },
    { "$ref": "#/$defs/DomainPack" },
    { "$ref": "#/$defs/MethodologyPack" },
    { "$ref": "#/$defs/QualityGate" },
    { "$ref": "#/$defs/Vocabulary" }
  ],
  "$defs": {
    "SemVer": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "NamespacedId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "VersionedRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+@(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "Status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated"]
    },
    "Header": {
      "type": "object",
      "required": ["kind", "id", "version", "title"],
      "properties": {
        "kind": { "type": "string" },
        "id": { "$ref": "#/$defs/NamespacedId" },
        "version": { "$ref": "#/$defs/SemVer" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/Status" },
        "description": { "type": "string" }
      }
    },
    "Objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version", "title", "root", "done_when"],
      "properties": {
        "kind": { "const": "objective" },
        "id": { "$ref": "#/$defs/NamespacedId" },
        "version": { "$ref": "#/$defs/SemVer" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/Status" },
        "description": { "type": "string" },
        "root": { "$ref": "#/$defs/VersionedRef" },
        "done_when": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "artifacts": { "type": "array", "items": { "$ref": "#/$defs/VersionedRef" } },
            "gates": { "type": "array", "items": { "$ref": "#/$defs/VersionedRef" } }
          }
        }
      }
    },
    "TaskTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version", "title", "type"],
      "properties": {
        "kind": { "const": "task_template" },
        "id": { "$ref": "#/$defs/NamespacedId" },
        "version": { "$ref": "#/$defs/SemVer" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/Status" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["composite", "leaf"] },
        "complexity": { "type": "string", "enum": ["trivial", "standard", "complex"] },
        "children": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "task"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "task": { "$ref": "#/$defs/VersionedRef" },
              "after": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": {
              "id": { "$ref": "#/$defs/NamespacedId" },
              "title": { "type": "string" },
              "accepts": { "type": "array", "items": { "type": "string", "enum": ["task", "gate"] } }
            }
          }
        },
        "executor": { "type": "string", "enum": ["llm", "script", "tool", "human", "hybrid"] },
        "requires": { "type": "object" },
        "produces": { "type": "object" },
        "context": { "type": "object" },
        "instruction": { "type": "string" },
        "completion": { "type": "object" },
        "validation": { "type": "object" },
        "clarification_policy": { "type": "object" },
        "skip": { "type": "object" },
        "effects": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "leaf" } } },
          "then": { "required": ["executor", "produces", "instruction"] }
        },
        {
          "if": { "properties": { "type": { "const": "composite" } } },
          "then": {
            "anyOf": [
              { "required": ["children"] },
              { "required": ["slots"] }
            ]
          }
        }
      ]
    },
    "ArtifactContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version", "title", "schema"],
      "properties": {
        "kind": { "const": "artifact_contract" },
        "id": { "$ref": "#/$defs/NamespacedId" },
        "version": { "$ref": "#/$defs/SemVer" },
        "title": { "type": "string" },
        "status": { "$ref": "#/$defs/Status" },
        "description": { "type": "string" },
        "schema": { "type": "object" }
      }
    },
    "DomainPack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version", "title", "contributes"],
      "properties": {
        "kind": { "const": "domain_pack" },
        "id": { "$ref": "#/$defs/NamespacedId" },
        "version": { "$ref": "#/$defs/SemVer" },
        "title": { "type": "string" },
        "status": { "$ref": "#/$defs/Status" },
        "description": { "type": "string" },
        "detect": { "type": "object" },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/VersionedRef" } },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/VersionedRef" } },
        "gates": { "type": "array", "items": { "$ref": "#/$defs/VersionedRef" } },
        "clarification_policy": { "type": "object" },
        "contributes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["to", "add"],
            "properties": {
              "to": { "$ref": "#/$defs/NamespacedId" },
              "when": { "type": "object" },
              "add": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                    "task": { "$ref": "#/$defs/VersionedRef" },
                    "gate": { "$ref": "#/$defs/VersionedRef" }
                  },
                  "oneOf": [
                    { "required": ["task"] },
                    { "required": ["gate"] }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "QualityGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version", "title", "check"],
      "properties": {
        "kind": { "const": "quality_gate" },
        "id": { "$ref": "#/$defs/NamespacedId" },
        "version": { "$ref": "#/$defs/SemVer" },
        "title": { "type": "string" },
        "status": { "$ref": "#/$defs/Status" },
        "description": { "type": "string" },
        "trigger": { "type": "object" },
        "requires": { "type": "object" },
        "check": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["human_approval", "external_signoff", "automated_review"] },
            "approver_role": { "type": "string" },
            "decision_modes": { "type": "array", "items": { "type": "string" } },
            "blocking": { "type": "boolean" },
            "timeout_hours": { "type": "integer", "minimum": 0 },
            "validator_ref": { "$ref": "#/$defs/VersionedRef" },
            "instruction": { "type": "string" }
          },
          "allOf": [
            {
              "if": { "properties": { "type": { "enum": ["human_approval", "external_signoff"] } } },
              "then": { "required": ["approver_role", "decision_modes"] }
            },
            {
              "if": { "properties": { "type": { "const": "automated_review" } } },
              "then": {
                "anyOf": [
                  { "required": ["validator_ref"] },
                  { "required": ["instruction"] }
                ]
              }
            }
          ]
        },
        "clarification_policy": { "type": "object" },
        "on_pass": { "type": "string" },
        "on_fail": { "type": "string" },
        "on_comments": { "type": "string" }
      }
    },
    "MethodologyPack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version", "title", "stages", "reasoning_artifact"],
      "properties": {
        "kind": { "const": "methodology_pack" },
        "id": { "$ref": "#/$defs/NamespacedId" },
        "version": { "$ref": "#/$defs/SemVer" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/Status" },
        "description": { "type": "string" },
        "stage_execution_mode": {
          "type": "string",
          "enum": ["single_call", "per_stage_cot"],
          "default": "single_call"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "produces"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "produces": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["field", "type"],
                  "properties": {
                    "field": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                    "type": { "type": "string" },
                    "required": { "type": "boolean" },
                    "nullable": { "type": "boolean" },
                    "schema": {},
                    "item_schema": {}
                  }
                }
              },
              "constraints": { "type": "object" },
              "rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                    "if": { "type": "string" },
                    "emit_candidate": { "type": "object" }
                  }
                }
              }
            }
          }
        },
        "reasoning_artifact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required_stages": { "type": "array", "items": { "type": "string" } },
            "optional_stages": { "type": "array", "items": { "type": "string" } }
          }
        },
        "complexity_overrides": { "type": "object" },
        "clarification_policy": { "type": "object" },
        "provenance": {
          "type": "object",
          "properties": {
            "emit_source_refs": { "type": "boolean" }
          }
        }
      }
    },
    "Vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version", "title", "entries"],
      "properties": {
        "kind": { "const": "vocabulary" },
        "id": { "$ref": "#/$defs/NamespacedId" },
        "version": { "$ref": "#/$defs/SemVer" },
        "title": { "type": "string" },
        "entries": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
