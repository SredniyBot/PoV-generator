{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pov-generator.local/schemas/task-node.schema.json",
  "title": "PoV Generator Task Node",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "project_id",
    "objective_ref",
    "template_ref",
    "template_type",
    "title",
    "status",
    "depth",
    "origin",
    "stable_key",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "task_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "objective_ref": { "type": "string" },
    "parent_task_id": { "type": ["string", "null"], "format": "uuid" },
    "template_ref": { "type": "string" },
    "template_type": { "type": "string", "enum": ["composite", "leaf"] },
    "title": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "ready",
        "blocked",
        "in_progress",
        "waiting_for_children",
        "completed",
        "failed",
        "skipped",
        "obsolete"
      ]
    },
    "depth": { "type": "integer", "minimum": 0 },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["objective_root", "base_child", "domain_contribution", "repair", "user_request", "system"]
        },
        "source_ref": { "type": ["string", "null"] },
        "slot_id": { "type": ["string", "null"] },
        "contribution_id": { "type": ["string", "null"] },
        "domain_pack_ref": { "type": ["string", "null"] }
      }
    },
    "stable_key": { "type": "string" },
    "priority_hint": { "type": "integer" },
    "attempt": { "type": "integer", "minimum": 0 },
    "blocking_clarification_ids": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" }
    },
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "started_at": { "type": ["string", "null"], "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
