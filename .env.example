# PoV Generator — environment configuration
#
# Copy this file to `.env` (already gitignored) and fill in the values you need.
# Everything below is optional — defaults are documented per variable.
#
# Loaded by `pov_generator.common.env.load_repo_env()` on startup of CLI / API.
#
# === ВАЖНО: ПЕРЕХОД С ENV НА UI ===
# С версии 0.2 LLM-провайдеры и модели настраиваются через UI
# (вкладка «Настройки» в шапке) и хранятся в `<runtime_root>/settings.db`.
# Env-переменные ниже остаются как:
#   1. Bootstrap при первом запуске: если БД пуста и в env есть ключи,
#      система автоматически создаёт connections с пометкой «из .env».
#   2. Fallback в тестах / CI, где UI недоступен.
#   3. Backward-compat для CLI флагов (`--provider`, `--model`).
#
# Управление через UI: предпочтительный путь для прода.
# Этот файл: только для bootstrap или dev-окружений.

# =============================================================================
# Server
# =============================================================================

# Bind address for `povgen-api`. Use 0.0.0.0 to expose on LAN.
# POV_HOST=127.0.0.1
# POV_PORT=8788

# Uvicorn options.
# POV_RELOAD=false
# POV_WORKERS=1
# POV_LOG_LEVEL=info

# =============================================================================
# LLM execution provider
# =============================================================================

# Which provider runs leaf tasks. Default = stub (deterministic fixtures, no network).
# Allowed: stub | openrouter | claude_sdk | claude_subscription
POV_EXECUTION_PROVIDER=stub

# --- OpenRouter ---------------------------------------------------------------
# POV_OPENROUTER_API_KEY=sk-or-v1-...
# POV_OPENROUTER_MODEL=deepseek/deepseek-chat

# --- Anthropic Claude (direct API) -------------------------------------------
# POV_ANTHROPIC_API_KEY=sk-ant-...
# Per-complexity model overrides (otherwise sensible defaults are used).
# POV_CLAUDE_MODEL_TRIVIAL=claude-haiku-4-5-20251001
# POV_CLAUDE_MODEL_STANDARD=claude-sonnet-4-6
# POV_CLAUDE_MODEL_COMPLEX=claude-opus-4-6
# POV_CLAUDE_MAX_TOKENS=8192

# --- Claude via local subscription CLI (no API key) --------------------------
# Requires `claude login` once (npm i -g @anthropic-ai/claude-code).
# POV_CLAUDE_SUBSCRIPTION_MODEL=...
#
# Путь к локальному `claude` CLI. По умолчанию резолвится через
# `shutil.which("claude")`. Override полезен, если `claude` не в PATH
# или вы намеренно хотите указать конкретный shim (например, .CMD на Windows).
# ВНИМАНИЕ: bundled CLI из claude-agent-sdk НЕ ИСПОЛЬЗУЕТСЯ — он не
# залогинен и поднимает "Control request timeout: initialize".
# POV_CLAUDE_CLI_PATH=C:\Users\User\AppData\Roaming\npm\claude.CMD
#
# Таймаут initialize-запроса к CLI (мс). По умолчанию 120 000 (120 сек) —
# вдвое больше дефолта SDK. Увеличьте если CLI на вашей машине стартует
# дольше (антивирус, медленный диск).
# POV_CLAUDE_LOAD_TIMEOUT_MS=120000

# =============================================================================
# Domain-pack auto-selection
# =============================================================================

# When the user does not pass --domain-pack, the system can pick packs
# automatically. By default uses the same provider as POV_EXECUTION_PROVIDER;
# override here if needed.
# POV_DOMAIN_PACK_SELECTION_PROVIDER=openrouter
# POV_DOMAIN_PACK_SELECTION_MODEL=deepseek/deepseek-chat

# =============================================================================
# Secret encryption (для API-ключей в settings.db)
# =============================================================================

# Fernet-ключ для шифрования секретов в БД настроек. Если не задан, ключ
# генерируется автоматически и сохраняется в `<runtime_root>/.secret_key`
# (gitignored). Для CI / docker задавайте явно, чтобы не зависеть от файла.
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# POV_SECRET_KEY=

# =============================================================================
# Advanced
# =============================================================================

# Disable per-template context budget (every task gets full context).
# Useful when debugging context-loss bugs; expensive for real LLM runs.
# POV_DISABLE_TEMPLATE_CONTEXT_BUDGET=false

# Activate the pre-task complexity selector (W3.2). When on, the system
# re-evaluates declared complexity per task based on actual context.
# POV_COMPLEXITY_SELECTOR=off
# POV_COMPLEXITY_SELECTOR_MODEL=...
